# Copy to .env and fill in ONE of the LLM options below.
# Check your provider's docs for current model names before you start.

# ---- Option A: Groq (free tier, fast; OpenAI-compatible) ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=llama-3.1-8b-instant

# ---- Option B: OpenAI ----
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ---- Option C: Anthropic ----
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-5-5

# ---- Option D: Ollama, fully local (ollama pull llama3.1:8b) ----
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# ---- Option E: Google Gemini (OpenAI-compatible endpoint) ----
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

# ---- No LLM at all (offline fallback / baseline) ----
# LLM_PROVIDER=extractive

# ---- Retrieval ----
GT_EMBEDDER=st                     # st (local dense) | tfidf (no download) | openai
GT_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
GT_CHUNKER=section                 # section | fixed
GT_CHUNK_SIZE=220
GT_TOP_K=5
# GT_MIN_SCORE=                    # set by: python eval/calibrate_threshold.py --write
